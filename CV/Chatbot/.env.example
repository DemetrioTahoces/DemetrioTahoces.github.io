# === Required ===
# API key del proveedor configurado en PROVIDER_NAME (Google AI Studio u OpenAI)
API_KEY=tu-api-key

# === Optional (defaults shown) ===
PROVIDER_NAME=gemini
MODEL_NAME=gemini-2.5-flash-lite
# Solo OpenAI (gpt-5.x). Vacío = valor por defecto del proveedor (medium).
# Recomendado para el chatbot: none (permite temperature=0.3 y menor latencia).
REASONING_EFFORT=
RATE_LIMIT_PER_MINUTE=5
RATE_LIMIT_PER_HOUR=20
ALLOWED_ORIGINS=https://demetriotahoces.github.io,http://localhost:3000,http://localhost:8000
LOG_LEVEL=INFO
