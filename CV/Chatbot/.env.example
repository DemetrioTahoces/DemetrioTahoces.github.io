# === Required ===
# API key del proveedor configurado en PROVIDER_NAME (OpenAI o Google AI Studio)
API_KEY=tu-api-key

# === Optional (defaults shown) ===
PROVIDER_NAME=openai
MODEL_NAME=gpt-5.6-luna
# Solo OpenAI (gpt-5.x): none, low, medium, high...
# Con none se envía temperature=0.3; con el resto se omite.
# Vacío = valor por defecto del proveedor (medium).
REASONING_EFFORT=low
RATE_LIMIT_PER_MINUTE=5
RATE_LIMIT_PER_HOUR=20
ALLOWED_ORIGINS=https://demetriotahoces.github.io,http://localhost:3000,http://localhost:8000
LOG_LEVEL=INFO
