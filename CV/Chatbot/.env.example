# === Obligatoria ===
# API key de OpenAI
API_KEY=tu-api-key

# === Opcionales (valores por defecto) ===
MODEL_NAME=gpt-6-luna
# none | low | medium | high ... Vacío = valor por defecto del proveedor.
# Con none se envía temperature=0.3; con el resto se omite.
REASONING_EFFORT=medium
MAX_OUTPUT_TOKENS=2000
REQUEST_TIMEOUT=30

# Límites por petición y memoria de conversación enviada por el cliente
MAX_MODEL_CALLS=3
MAX_TOOL_CALLS=2
MAX_HISTORY_MESSAGES=10

RATE_LIMIT_PER_MINUTE=5
RATE_LIMIT_PER_HOUR=20
# Lista separada por comas
ALLOWED_ORIGINS=https://demetriotahoces.github.io,http://localhost:8000,http://127.0.0.1:8000
LOG_LEVEL=INFO

# === Tracing opcional con LangSmith ===
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=cv-chatbot

# === Solo evals ===
# EVAL_JUDGE_MODEL=gpt-6-luna
