{
  "install-git-hooks": {
    "SessionStart": [
      {
        "type": "command",
        "command": "python3 ../scripts/install_hooks.py --json",
        "timeout": 15
      }
    ]
  },
  "pre-push-gate": {
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ../scripts/pre_push_gate.py",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
